VITE_API_BASE_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_MARKETING_OWNER_NAME=Platform Owner
VITE_MARKETING_OWNER_EMAIL=owner@example.com
VITE_MARKETING_OWNER_PHONE=+255700000000
VITE_MARKETING_OWNER_WHATSAPP=255700000000
VITE_MARKETING_OWNER_COMPANY=SACCOS Control

# Idle session timeout (applies to every signed-in user).
# After VITE_SESSION_IDLE_MINUTES of inactivity, a countdown warning shows for
# VITE_SESSION_WARNING_SECONDS before the user is automatically signed out.
# Both are optional; defaults are 15 minutes idle and a 60 second warning.
VITE_SESSION_IDLE_MINUTES=15
VITE_SESSION_WARNING_SECONDS=60

# Sign-in username domain: firstname.surname resolves to firstname.surname@ias.co.tz
VITE_LOGIN_EMAIL_DOMAIN=ias.co.tz
